# Supabase — runtime (transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase — session pooler (port 5432), used by prisma db push/migrate and batch scripts
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Shared secret for the /api/collect cron endpoint (optional locally, required in prod)
CRON_SECRET="change-me"

# Worker poll interval (local worker only)
COLLECT_INTERVAL_SECONDS="120"
